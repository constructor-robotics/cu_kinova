<?xml version="1.0"?>

<robot name="cu_kinova" xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:include filename="$(find kortex_description)/robots/kortex_robot.xacro" />
    <xacro:include filename="$(find cu_kinova_description)/urdf/table.urdf.xacro" />
    
    <link name="wall">
        <visual>
            <geometry>
                <box size="2 0.2 3"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="white">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="3 0.5 3"/>
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </collision>

    </link>
    <joint name="wall_joint" type="fixed">
        <parent link="table" />
        <child link="wall" />
        <origin xyz="-0.18238 1.1074 1.5" rpy="0 0 0.43" />
    </joint>
    <xacro:table length="0.8" width="1.6" height="0.72" name="table" /> 
    <xacro:table length="0.6" width="1" height="0.735" name="operator_table" /> 
    <joint name="operator_table_joint" type="fixed">
        <parent link="table" />
        <child link="operator_table" />
        <origin xyz="-0.7 0 0" rpy="0 0 0" />
    </joint>
    <xacro:property name="clearance_height" value="0.6"/>
    <material name="clearance_volume">
        <color rgba="0.6 0.4 0.2 0.2"/>
    </material>
    <link name="operator_clearance">
        <visual>
            <geometry>
                <box size="0.6 1 ${clearance_height}"/>
            </geometry>
            <origin xyz="0 0 0.0" rpy="0 0 0"/>
            <material name="clearance_volume"/>
        </visual>
        <collision>
            <geometry>
                <box size="0.6 1 ${clearance_height}"/>
            </geometry>
            <origin xyz="0 0 0.0" rpy="0 0 0"/>
        </collision>
    </link>
    <joint name="operator_clearance_joint" type="fixed">
        <parent link="operator_table_top"/>
        <child link="operator_clearance"/>
        <origin xyz="0.0 0.0 ${clearance_height/2}" rpy="0 0 0"/>
    </joint>

    <joint name="table_top_to_left_base_joint" type="fixed">
        <child link="left_base_link" />
        <parent link="table_top" />
	<!-- TODO: model the black mounting plates that represent the 0.02m in z -->
        <origin xyz="${-0.4+0.09} ${0.8-0.29} 0.02" rpy="0 0 0"/>
    </joint> 
    <joint name="left_to_right_base" type="fixed">
        <child link="right_base_link" />
        <parent link="left_base_link" />
        <origin xyz="-0.0291376 -1.0805 0" rpy="0 0 0" />
    </joint>

    <xacro:load_robot 
        arm="gen3"
        gripper="robotiq_2f_85"
        dof="7"
        vision="true"
        sim="false"
        prefix="left_"
    />

    <xacro:load_robot
        arm="gen3"
        gripper="robotiq_2f_85"
        dof="7"
        vision="true"
        sim="false"
        prefix="right_"
    />
</robot>
